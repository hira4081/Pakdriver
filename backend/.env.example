# Postgres connection (Neon / Supabase / Railway / Render all work)
DATABASE_URL=postgres://user:password@host:5432/pakdrive?sslmode=require
# long random string:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Google OAuth *Web* client ID (same one the Flutter app uses as serverClientId).
# Comma separate if you have more than one.
GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
PORT=8080
CORS_ORIGIN=*
